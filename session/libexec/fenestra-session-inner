#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Runs inside KWin (WAYLAND_DISPLAY and DISPLAY are set). When this exits, KWin and the
# session end: that happens when fenestra-session.target stops (log out).
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP XDG_SESSION_TYPE DESKTOP_SESSION QT_QPA_PLATFORM MOZ_ENABLE_WAYLAND \
    ELECTRON_OZONE_PLATFORM_HINT LC_NUMERIC LC_TIME LC_MONETARY LC_PAPER LC_MEASUREMENT PATH GTK_USE_PORTAL
# Tell GDM the display is up, as GNOME's compositor does. Without it GDM waits 10 s, quits the boot
# splash without a transition, the console goes back to VT 1 and GDM opens its own sign-in screen
# over Fenestra's lock screen (and KWin loses the screen for a moment).
busctl --system call org.gnome.DisplayManager /org/gnome/DisplayManager/Manager \
    org.gnome.DisplayManager.Manager RegisterDisplay >/dev/null 2>&1 || true
# GTK apps read the mode, accent and theme from gsettings: bring them in line with shell.conf.
command -v fenestra-settings >/dev/null && fenestra-settings --sync-appearance >/dev/null 2>&1 &
systemctl --user start fenestra-session.target
# Block until the target stops, without polling: this unit is bound to it.
systemd-run --user --wait --quiet --collect --unit=fenestra-session-lifetime \
    -p BindsTo=fenestra-session.target -p After=fenestra-session.target sleep infinity
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP
