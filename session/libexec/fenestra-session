#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Fenestra session (started by GDM from /usr/share/wayland-sessions/fenestra.desktop).
# KWin composites; everything else runs as systemd user units of fenestra-session.target,
# so a crash of the shell never ends the session or loses windows.
export XDG_CURRENT_DESKTOP=Fenestra XDG_SESSION_DESKTOP=fenestra XDG_SESSION_TYPE=wayland
export DESKTOP_SESSION=fenestra
# Qt apps follow Fenestra (no Plasma platform theme); GTK apps keep their own settings.
export QT_QPA_PLATFORM="wayland;xcb" QT_WAYLAND_DISABLE_WINDOWDECORATION=0
export MOZ_ENABLE_WAYLAND=1 ELECTRON_OZONE_PLATFORM_HINT=auto
# Programs installed per user (~/.local/bin: Fenestra apps installed for one user, pip --user…) for
# everything launched from Start too (systemd user services get this PATH; Fedora only adds it in bash).
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$HOME/bin:$PATH" ;; esac
# Per-user overrides of the variables below (KEY=value lines), e.g. KWIN_USE_OVERLAYS=1.
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/fenestra/session.env" ] && set -a && . "${XDG_CONFIG_HOME:-$HOME/.config}/fenestra/session.env" && set +a
# No hardware overlay planes: when a shell popup closed, KWin moved windows onto overlay planes and
# the plane reconfiguration dropped a frame (every window flickered once; i915 "Atomic commit failed:
# EBUSY" / "FIFO underrun" on Meteor Lake). Composited frames only; fullscreen direct scanout stays.
export KWIN_USE_OVERLAYS="${KWIN_USE_OVERLAYS:-0}"
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/fenestra"
# "Sign in to the new desktop" (Settings) chooses Fenestra for one sign-in only: unless the user
# made it the default (fenestra-migrate set-default, recorded in /var/lib/fenestra/migrate.json),
# the next sign-in goes back to GNOME. Fenestra's sign-in screen has no session menu, so this
# keeps a failing first start from trapping the user in a loop.
if ! python3 -c 'import json,os,sys; sys.exit(0 if os.environ["USER"] in json.load(open("/var/lib/fenestra/migrate.json")).get("default_for", []) else 1)' 2>/dev/null; then
    for m in SetSession SetXSession; do
        busctl --system call org.freedesktop.Accounts "/org/freedesktop/Accounts/User$(id -u)" \
            org.freedesktop.Accounts.User "$m" s gnome >/dev/null 2>&1 || true
    done
fi
# Regional formats (gnome-session exported them in GNOME): AccountsService FormatsLocale, else
# the org.gnome.system.locale region the setup / Settings wrote.
fmt=$(busctl --system get-property org.freedesktop.Accounts "/org/freedesktop/Accounts/User$(id -u)" \
      org.freedesktop.Accounts.User FormatsLocale 2>/dev/null | sed -n 's/^s "\(.*\)"$/\1/p')
[ -n "$fmt" ] || fmt=$(gsettings get org.gnome.system.locale region 2>/dev/null | tr -d "'")
if [ -n "$fmt" ]; then
    export LC_NUMERIC=$fmt LC_TIME=$fmt LC_MONETARY=$fmt LC_PAPER=$fmt LC_MEASUREMENT=$fmt
fi
# KWin defaults for the Fenestra session, only where the user has not chosen something else:
# Super alone opens Start: older KWin reads [ModifierOnlyShortcuts]; KWin 6.8 handles it as the
# shell's "start" global shortcut (Meta), which fenestra-shell registers itself. Super+S opens Search.
kread() { kreadconfig6 --file kwinrc --group "$1" --key "$2" 2>/dev/null; }
kwrite() { [ -n "$(kread "$1" "$2")" ] || kwriteconfig6 --file kwinrc --group "$1" --key "$2" "$3"; }
kwrite ModifierOnlyShortcuts Meta "org.fenestra.Shell,/org/fenestra/Shell,org.fenestra.Shell,ToggleStart"
exec kwin_wayland_wrapper --xwayland --exit-with-session /usr/libexec/fenestra/fenestra-session-inner
