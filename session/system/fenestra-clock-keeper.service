[Unit]
Description=Fenestra: start the clock from the last known time, not weeks behind
Documentation=https://github.com/miguelcoxcaballero/fenestra-os/tree/main/session
DefaultDependencies=no
RequiresMountsFor=/var/lib
After=local-fs.target
Before=time-set.target sysinit.target chronyd.service systemd-timesyncd.service shutdown.target
Wants=time-set.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/fenestra/fenestra-clock-keeper restore
# at shutdown and reboot
ExecStop=/usr/libexec/fenestra/fenestra-clock-keeper save

[Install]
WantedBy=sysinit.target
