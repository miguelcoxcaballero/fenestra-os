[Unit]
Description=Fenestra Shell (taskbar, Start, quick settings, desktop)
PartOf=fenestra-session.target
After=fenestra-session.target
# Three crashes in two minutes: stop relaunching and show the minimal notice instead.
StartLimitIntervalSec=120
StartLimitBurst=3
OnFailure=fenestra-shell-failed.service

[Service]
Type=simple
ExecStart=/usr/bin/fenestra-shell
Restart=on-failure
RestartSec=1
Slice=session.slice
ExecStopPost=/usr/libexec/fenestra/fenestra-shell-crashlog
