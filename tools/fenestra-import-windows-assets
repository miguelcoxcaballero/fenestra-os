    'weather-freezing-rain': ['FreezingRainV2', 'IcePelletsV2'],
}
WEATHER_SVG_EXTRA = {'filter', 'feGaussianBlur', 'feOffset', 'feFlood', 'feBlend', 'feColorMatrix', 'feComposite',
                     'feMerge', 'feMergeNode', 'feMorphology', 'feDropShadow'}


def install_weather(root, dest, theme_dir, overrides):
    wdir = root / 'weather'
    try:
        index = json.loads((wdir / 'weather.json').read_text(encoding='utf-8'))
    except (OSError, ValueError, UnicodeDecodeError):
        return 0
    icons = index.get('icons') if isinstance(index.get('icons'), dict) else {}
    have = {}
    for name, meta in icons.items():
        if not re.match(r'^[A-Za-z0-9_-]{1,64}$', name) or not isinstance(meta, dict) or meta.get('file') != f'{name}.svg':
            continue
        src = wdir / f'{name}.svg'
        if not src.is_file() or src.is_symlink():
            continue
        data = src.read_bytes()
        why = svg_problem(data, limit=256 * 1024, extra=WEATHER_SVG_EXTRA)
        if why:
            log(f'weather: {name}.svg refused ({why})')
            continue
        out = dest / 'weather' / f'{name}.svg'
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_bytes(data)
        have[name] = out
    (dest / 'weather').mkdir(parents=True, exist_ok=True)
    shutil.copyfile(wdir / 'weather.json', dest / 'weather' / 'weather.json')
    mapped = 0
    for target, choices in WEATHER_TARGETS.items():
        src = next((have[c] for c in choices if c in have), None)
        if src is None:
            continue
        mapped += 1
        # Windows draws the coloured condition icon on light and dark taskbars alike.
        for name in (target, target + '-symbolic'):
            overrides['icons'][name] = [str(src)]
            overrides['icons_light'][name] = [str(src)]
        if theme_dir is not None:
            _place(src, theme_dir / 'scalable' / 'status' / f'{target}.svg')
    if theme_dir is not None and mapped:
        _index_dirs(theme_dir, ['scalable/status'])
    log(f'weather: {len(have)} Windows condition icons, {mapped} of {len(WEATHER_TARGETS)} Fenestra weather states mapped')
    return mapped


