def caption_icon(data):
    """16 x 16 SVG with the glyph SVG `data` scaled into the 10 x 10 box at (3, 3)."""
    text = data.decode('utf-8')
    vb = re.search(r'viewBox="([-\d.\s]+)"', text)
    x, y, w, h = (float(v) for v in vb.group(1).split()) if vb else (0, 0, 16, 16)
    inner = re.sub(r'^.*?<svg[^>]*>', '', text, count=1, flags=re.S)
    inner = re.sub(r'</svg>\s*$', '', inner.strip())
    k = 10 / max(w, h)
    return ('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">'
            f'<g transform="translate(3 3) scale({k:.8g}) translate({-x:g} {-y:g})">{inner}</g></svg>\n').encode()


