DATA = Path(os.environ.get('XDG_DATA_HOME', HOME / '.local/share'))
ASSETS = DATA / 'fenestra' / 'assets'
FONTS = ['segoeui.ttf', 'segoeuib.ttf', 'segoeuii.ttf', 'segoeuiz.ttf', 'segoeuil.ttf', 'segoeuisl.ttf',
         'seguisb.ttf', 'seguisbi.ttf', 'SegUIVar.ttf', 'SegoeIcons.ttf', 'consola.ttf', 'consolab.ttf',
         'consolai.ttf', 'consolaz.ttf']


def log(msg):
    print(f'fenestra-import: {msg}', flush=True)


# When False (--no-apply, tests) nothing outside XDG_DATA_HOME is touched:
# no gsettings writes, no font/icon cache refresh.
APPLY = True


def gsettings_set(schema, key, value):
    if APPLY:
        subprocess.run(['gsettings', 'set', schema, key, value], check=False)


def schema_has_key(schema, key):
    try:
        r = subprocess.run(['gsettings', 'list-keys', schema], capture_output=True, text=True)
    except OSError:
        return False
    return r.returncode == 0 and key in r.stdout.split()


def mount_windows_partitions():
    """Mount unmounted NTFS partitions read-only through UDisks (no root needed
    for the logged-in user; polkit may ask for the password once)."""
    import json
    try:
        out = subprocess.run(['lsblk', '-J', '-o', 'PATH,FSTYPE,MOUNTPOINT'], capture_output=True, text=True).stdout
        devices = json.loads(out).get('blockdevices', [])
    except (OSError, ValueError):
        return []
    mounted = []

    def walk(items):
        for d in items:
            yield d
            yield from walk(d.get('children') or [])
    for d in walk(devices):
        if d.get('fstype') == 'ntfs' and not d.get('mountpoint'):
            r = subprocess.run(['udisksctl', 'mount', '--no-user-interaction', '-b', d['path'], '-o', 'ro'],
                               capture_output=True, text=True)
            if r.returncode != 0:
                r = subprocess.run(['udisksctl', 'mount', '-b', d['path'], '-o', 'ro'], capture_output=True, text=True)
            if r.returncode == 0 and ' at ' in r.stdout:
                mounted.append(r.stdout.strip().split(' at ', 1)[1].rstrip('.'))
    return mounted


def find_windows(explicit=None):
    candidates = [explicit] if explicit else []
    candidates += ['/mnt/windows', '/mnt/c', '/media/windows']
    candidates += glob.glob(f'/run/media/{os.environ.get("USER", "")}/*') + glob.glob('/mnt/*') + glob.glob('/media/*/*')
    for c in candidates:
        if c and Path(c, 'Windows', 'Fonts', 'segoeui.ttf').exists():
            return Path(c)
    if not explicit:
        for c in mount_windows_partitions():
            if Path(c, 'Windows', 'Fonts', 'segoeui.ttf').exists():
                return Path(c)
    return None


def ci(path: Path):
    """Case-insensitive path resolution on NTFS mounts."""
    if path.exists():
        return path
    cur = Path(path.anchor)
    for part in path.parts[1:]:
        match = next((p for p in cur.iterdir() if p.name.lower() == part.lower()), None) if cur.is_dir() else None
        if not match:
            return None
        cur = match
    return cur


# ------------------------------------------------------------------ fonts ---
def import_fonts(win, dry):
    dest = DATA / 'fonts' / 'fenestra-windows'
    copied = 0
    for name in FONTS:
        src = ci(win / 'Windows' / 'Fonts' / name)
        if src:
            copied += 1
            if not dry:
                dest.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dest / name)
    if copied and not dry and APPLY:
        subprocess.run(['fc-cache', '-f', str(dest)], check=False)
    log(f'fonts: {copied} files')


# ---------------------------------------------------------------- cursors ---
def _chunks(d, start=0):
    while start + 8 <= len(d):
        typ, n = struct.unpack_from('<4sI', d, start)
        yield typ, d[start + 8:start + 8 + n]
        start += 8 + n + n % 2


def _cur(data):
    from PIL import Image
    _, _, n = struct.unpack_from('<HHH', data)
    res = []
    for i in range(n):
        w, h, _, _, hx, hy, size, offset = struct.unpack_from('<BBBBHHII', data, 6 + 16 * i)
        w, h = w or 256, h or 256
        dib = data[offset:offset + size]
        if dib.startswith(b'\x89PNG'):
            im = Image.open(io.BytesIO(dib)).convert('RGBA')
        else:
            hdr, _, _, _, bits = struct.unpack_from('<IiiHH', dib)
            pal = (1 << bits) * 4 if bits <= 8 else 0
            xs, ms = ((w * bits + 31) // 32) * 4, ((w + 31) // 32) * 4
            px = hdr + pal
            mo = px + xs * h
            palette = [struct.unpack_from('<BBBB', dib, hdr + 4 * k) for k in range(pal // 4)]
            im = Image.new('RGBA', (w, h))
            P = im.load()
            for y in range(h):
                row, mrow = px + (h - 1 - y) * xs, mo + (h - 1 - y) * ms
                for x in range(w):
                    andb = (dib[mrow + x // 8] >> (7 - x % 8)) & 1 if mo + ms * h <= len(dib) else 0
                    if bits == 32:
                        b, g, r, a = dib[row + 4 * x:row + 4 * x + 4]
                        if a == 0 and not andb and (r or g or b):
                            a = 255
                        P[x, y] = (r, g, b, 0 if andb and a == 0 else a)
                    else:
                        idx = ((dib[row + x // 8] >> (7 - x % 8)) & 1 if bits == 1 else
                               (dib[row + x // 2] >> (4 * (1 - x % 2))) & 15 if bits == 4 else dib[row + x])
                        b, g, r, _ = palette[idx]
                        P[x, y] = ((255, 255, 255, 255) if (r or g or b) else (0, 0, 0, 0)) if andb else (r, g, b, 255)
        res.append((w, im, hx, hy))
    return res


def _ani(d):
    parts = dict(_chunks(d, 12))
    hdr = struct.unpack('<9I', parts[b'anih'])
    frames = [_cur(v) for t, v in _chunks(parts[b'LIST'], 4) if t == b'icon']
    seq = struct.unpack('<' + 'I' * (len(parts[b'seq ']) // 4), parts[b'seq ']) if b'seq ' in parts else list(range(len(frames)))
    rates = struct.unpack('<' + 'I' * (len(parts[b'rate']) // 4), parts[b'rate']) if b'rate' in parts else [hdr[7]] * len(seq)
    return [(frames[j], round(1000 * rates[i] / 60)) for i, j in enumerate(seq)]


def _xcursor(path, frames):
    blobs, toc, pos = [], [], 16 + 12 * len(frames)
    for im, hx, hy, delay, size in frames:
        w, h = im.size
        pix = bytearray()
        for r, g, b, a in im.getdata():
            pix += struct.pack('<I', (a << 24) | ((r * a // 255) << 16) | ((g * a // 255) << 8) | (b * a // 255))
        c = struct.pack('<9I', 36, 0xfffd0002, size, 1, w, h, hx, hy, delay) + pix
        toc.append(struct.pack('<III', 0xfffd0002, size, pos))
        blobs.append(c)
        pos += len(c)
    path.write_bytes(struct.pack('<4sIII', b'Xcur', 16, 0x10000, len(frames)) + b''.join(toc) + b''.join(blobs))


CURSOR_MAP = {'left_ptr': 'aero_arrow', 'hand2': 'aero_link', 'xterm': 'beam_r', 'crosshair': 'cross_r',
