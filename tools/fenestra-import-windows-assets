def _svg_paths(data):
    """viewBox and the <path> elements of a glyph SVG written by the extractor."""
    import xml.etree.ElementTree as ET
    root = ET.fromstring(data)
    return root.get('viewBox'), [el.get('d') for el in root.iter(SVG_NS + 'path') if el.get('d')]


def install_codepoint_glyphs(dest, theme_dir, overrides, gtk_names):
    udir = dest / 'glyphs' / 'u'
    if not udir.is_dir():
        log('quick settings / tray glyphs: the pack has no glyphs/u (export with --all-glyphs)')
        return 0
    out_dir = dest / 'glyphs' / 'cp'
    out_dir.mkdir(parents=True, exist_ok=True)
    (out_dir / 'white').mkdir(exist_ok=True)
    done = 0
    for key, (layers, targets) in CODEPOINT_TARGETS.items():
        parts, box = [], None
        for layer in layers:
            cp, _, alpha = layer.partition('@')
            f = udir / f'{cp}.svg'
            if not f.is_file():
                parts = None
                break
            vb, ds = _svg_paths(f.read_bytes())
            box = box or vb
            op = f' fill-opacity="{float(alpha):g}"' if alpha else ''
            parts += [f'<path fill="currentColor"{op} fill-rule="nonzero" d="{d}"/>' for d in ds]
        if not parts:
            continue
        svg = (f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="{box}" width="16" height="16">' + ''.join(parts) + '</svg>\n').encode()
        orig, white = out_dir / f'{key}.svg', out_dir / 'white' / f'{key}.svg'
        orig.write_bytes(svg)
        white.write_bytes(_white(svg))
        done += 1
        for target in targets:
            kind, _, what = target.partition(':')
            if kind in ('icon', 'shell') and what in overrides['icons']:
                continue                     # a glyph of icons.json (checked on the reference shots) already
            if kind == 'asset':
                if what not in overrides['assets']:
                    overrides['assets'][what] = str(white)
                    overrides['assets_light'][what] = str(orig)
                continue
            if kind in ('icon', 'shell'):
                overrides['icons'][what] = [str(white)]
                overrides['icons_light'][what] = [str(orig)]
            if kind in ('icon', 'gtk') and theme_dir is not None:
                gtk_names.append((what, orig))
    log(f'quick settings / tray glyphs: {done} of {len(CODEPOINT_TARGETS)} from Segoe Fluent Icons code points')
    return done


def install_glyphs_and_logos(root, pack_id, theme_name):
    """Install glyphs/ and the app logos of a validated, extracted pack; write icon-overrides.json.

    Returns the overrides dict. Unsafe or unlisted files are skipped with a log line, never installed."""
    dest = PACKS / pack_id
    if dest.exists():
        shutil.rmtree(dest)
    overrides = {'version': 1, 'pack': pack_id, 'icons': {}, 'icons_light': {}, 'assets': {}, 'assets_light': {},
                 'snip': {}, 'glyphs': {}}
    theme_dir = DATA / 'icons' / theme_name if theme_name else None

    # glyphs/
    gdir = root / 'glyphs'
    index = {}
    if (gdir / 'glyphs.json').is_file():
        try:
            index = json.loads((gdir / 'glyphs.json').read_text(encoding='utf-8'))
        except (ValueError, UnicodeDecodeError):
            log('glyphs: glyphs.json is not valid JSON, glyphs skipped')
            index = {}
    entries = index.get('glyphs') if isinstance(index.get('glyphs'), dict) else {}
    total, installed, refused = 0, {}, 0
    for name, meta in sorted(entries.items()):
        if not _GLYPH_NAME_RE.match(name) or not isinstance(meta, dict) or meta.get('file') != f'{name}.svg':
            refused += 1
            continue
        src = gdir / f'{name}.svg'
        if not src.is_file() or src.is_symlink():
            continue
        data = src.read_bytes()
        why = svg_problem(data)
        total += len(data)
        if why or total > GLYPH_MAX_TOTAL:
            log(f'glyphs: {name}.svg refused ({why or "glyphs/ over 16 MB"})')
            refused += 1
            continue
        out = dest / 'glyphs' / f'{name}.svg'
        white = dest / 'glyphs' / 'white' / f'{name}.svg'
        out.parent.mkdir(parents=True, exist_ok=True)
        white.parent.mkdir(parents=True, exist_ok=True)
        out.write_bytes(data)
        white.write_bytes(_white(data))
        installed[name] = (out, white)
        overrides['glyphs'][name] = str(out)
    # glyphs/u/XXXX.svg (--all-glyphs): kept for people who pick substitutes themselves
    udir = gdir / 'u'
    if udir.is_dir():
        n = 0
        for f in sorted(udir.glob('*.svg')):
            if not re.match(r'^[0-9A-F]{4,6}\.svg$', f.name) or f.is_symlink():
                continue
            data = f.read_bytes()
            total += len(data)
            if total > GLYPH_MAX_TOTAL * 4 or svg_problem(data):
                continue
            (dest / 'glyphs' / 'u').mkdir(parents=True, exist_ok=True)
            (dest / 'glyphs' / 'u' / f.name).write_bytes(data)
            n += 1
        if n:
            log(f'glyphs: {n} code point SVGs (glyphs/u)')
    gtk_names = []
    for name, (orig, white) in installed.items():
        # Glyphs with no explicit target (most of the app glyphs: Explorer, Notepad, Paint, Task
        # Manager, Settings, Store) are named after the freedesktop icon they stand for, so they go
        # into the theme under that name: apps that ask the theme for «edit-rename-symbolic» get it.
        targets = GLYPH_TARGETS.get(name) or [f'icon:{name}-symbolic']
        for target in targets:
            kind, _, what = target.partition(':')
            if kind in ('icon', 'shell'):
                overrides['icons'][what] = [str(white)]
                overrides['icons_light'][what] = [str(orig)]
                if kind == 'icon' and theme_dir is not None:
                    gtk_names.append((what, orig))
            elif kind == 'asset':
                overrides['assets'][what] = str(white)
                overrides['assets_light'][what] = str(orig)
            elif kind == 'snip':
                overrides['snip'][what] = str(white)
    if theme_dir is not None or (gdir / 'u').is_dir():
        install_codepoint_glyphs(dest, theme_dir, overrides, gtk_names)
    if gtk_names:
        _ensure_scalable_dir(theme_dir)
        sdir = theme_dir / 'scalable' / 'actions'
        sdir.mkdir(parents=True, exist_ok=True)
        for what, orig in gtk_names:
            if what in CAPTION_ICONS:
                (sdir / f'{what}.svg').write_bytes(caption_icon(orig.read_bytes()))
            else:
                shutil.copyfile(orig, sdir / f'{what}.svg')
    if entries:
        mapped = sum(1 for n in installed if n in GLYPH_TARGETS)
        log(f'glyphs: {len(installed)} installed ({mapped} replace Fenestra glyphs), {refused} refused, '
            f'missing in pack: {", ".join(index.get("missing", [])) or "none"}')

    # app logos: icons/<theme>/<n>x<n>/apps/<name>.png (installed with the theme) + apps/light/
    apps_index = {}
    if (root / 'apps' / 'apps.json').is_file():
        try:
            apps_index = json.loads((root / 'apps' / 'apps.json').read_text(encoding='utf-8')).get('apps', {})
        except (ValueError, UnicodeDecodeError, AttributeError):
            log('apps: apps.json is not valid JSON')
            apps_index = {}
    if not isinstance(apps_index, dict):
        apps_index = {}
    n_apps = 0
    for name, meta in sorted(apps_index.items()):
        if not _APP_NAME_RE.match(name) or not isinstance(meta, dict) or meta.get('status') not in ('exported', 'candidate'):
            continue
        dark = sorted(theme_dir.glob(f'*x*/apps/{name}.png'), key=lambda p: int(p.parts[-3].split('x')[0])) \
            if theme_dir is not None and theme_dir.is_dir() else []
        dark = [p for p in dark if (sz := _png_size(p.read_bytes()[:32])) and sz[0] == sz[1] == int(p.parts[-3].split('x')[0])]
        light = []
        ldir = root / 'apps' / 'light'
        for p in sorted(ldir.glob(f'*x*/{name}.png')) if ldir.is_dir() else []:
            data = p.read_bytes()
            sz = _png_size(data)
            if p.is_symlink() or len(data) > LOGO_MAX_FILE or not sz or not re.match(r'^\d+x\d+$', p.parent.name) \
                    or sz != (int(p.parent.name.split('x')[0]),) * 2:
                continue
            out = dest / 'apps' / 'light' / p.parent.name / p.name
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_bytes(data)
            light.append(out)
        if not dark:
            continue
        n_apps += 1
        for alias in [name] + APP_ALIASES.get(name, []):
            files = []
            for p in dark:
                target = p.with_name(f'{alias}.png')
                if target != p:
                    shutil.copyfile(p, target)
                files.append(str(target))
            overrides['icons'][alias] = files
            if light:
                overrides['icons_light'][alias] = [str(p) for p in light]
    if apps_index:
        log(f'apps: {n_apps} app logos ({sum(len(APP_ALIASES.get(n, [])) for n in apps_index if n in APP_ALIASES)} aliases for Fenestra apps)')

    # bitmaps/ (reference bitmaps; kept with the pack, not mapped yet) and the indexes, for checking
    for sub in ('bitmaps', 'apps'):
        for f in (root / sub).rglob('*') if (root / sub).is_dir() else []:
            if f.is_file() and not f.is_symlink() and f.suffix.lower() in ('.png', '.json') and f.stat().st_size <= LOGO_MAX_FILE:
                if f.suffix.lower() == '.png' and not _png_size(f.read_bytes()[:32]):
                    continue
                out = dest / f.relative_to(root)
                out.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(f, out)
    if (gdir / 'glyphs.json').is_file():
        (dest / 'glyphs').mkdir(parents=True, exist_ok=True)
        shutil.copyfile(gdir / 'glyphs.json', dest / 'glyphs' / 'glyphs.json')

    # Taskbar / Quick Settings battery pictures composed from Sysbatt.ttf (build_battery): Fenestra Shell
    # asks for /usr/share/fenestra/assets/battery/... and status/...
    for f in sorted((ASSETS / 'battery').glob('*.svg')) if (ASSETS / 'battery').is_dir() else []:
        for rel in (f'battery/{f.name}',) + ((f'status/{f.name}',) if re.match(r'^(normal|charging)-0-\d+\.svg$', f.name) else ()):
            overrides['assets'][rel] = str(f)
            overrides['assets_light'][rel] = str(f)

    # file types, folders, drives and places (filetypes/) and weather condition icons (weather/)
    install_filetypes(root, dest, theme_dir, overrides)
    install_weather(root, dest, theme_dir, overrides)

    OVERRIDES.parent.mkdir(parents=True, exist_ok=True)
    tmp = OVERRIDES.with_suffix('.json.tmp')
    tmp.write_text(json.dumps(overrides, indent=1, sort_keys=True) + '\n')
    os.replace(tmp, OVERRIDES)
    if theme_dir is not None and theme_dir.is_dir() and APPLY:
        subprocess.run(['gtk-update-icon-cache', '-q', '-f', '-t', str(theme_dir)], check=False)
    return overrides


def import_pack(path, dry=False):
    info = inspect_pack(path)
    m = info['manifest']
    src = m.get('source') if isinstance(m.get('source'), dict) else {}
    log(f'pack: {m.get("name")} [{info["kind"]}]'
        + (f' from {src.get("os", "?")} {src.get("build", "")}'.rstrip() if src else ''))
    if dry:
        log(f'pack: {len(info["names"])} files, {info["total"] // 1024} KiB — dry run, nothing installed')
        return info
    with tempfile.TemporaryDirectory(prefix='fenestra-pack-') as tmp:
        safe_extract(path, tmp)
        root = Path(tmp) / info['prefix']
        if info['kind'] == 'theme':
            install_icon_theme(root, info['theme_name'], inherit_fenestra=False)
            gsettings_set('org.gnome.desktop.interface', 'icon-theme', info['theme_name'])
            log(f'icons: installed theme {info["theme_name"]}')
            return info
        pack_id = m['id']
        # fonts
        fonts = [p for p in (root / 'fonts').glob('*') if p.suffix.lower() in ('.ttf', '.otf', '.ttc')] \
            if (root / 'fonts').is_dir() else []
        if fonts:
            fdest = DATA / 'fonts' / 'fenestra-pack' / pack_id
            fdest.mkdir(parents=True, exist_ok=True)
            for f in fonts:
                shutil.copyfile(f, fdest / f.name)
            if APPLY:
                subprocess.run(['fc-cache', '-f', str(fdest)], check=False)
            log(f'fonts: {len(fonts)} files')
        # cursors
        cdir = root / 'cursors'
        if cdir.is_dir() and any(p.suffix.lower() in ('.cur', '.ani') for p in cdir.iterdir()):
            try:
                build_cursor_theme(cdir, m.get('cursor_theme') or 'Fenestra-Pack-Cursors', False,
                                   comment=f'Cursors from the icon pack {m.get("name")}')
            except ImportError:
                log('cursors: python3-pillow not installed, skipped')
        # battery glyphs from the raw font
        sysbatt = _find_ci(root, 'raw/Sysbatt.ttf')
        if sysbatt:
            build_battery(sysbatt, False)
        # assets
        adir = root / 'assets'
        if adir.is_dir():
            ASSETS.mkdir(parents=True, exist_ok=True)
            shutil.copytree(adir, ASSETS, symlinks=False, dirs_exist_ok=True)
            logo = _find_ci(ASSETS, 'branding/start-button.svg', 'branding/start-button.png')
            if logo and (adir / 'branding').is_dir():
                apply_start_logo(logo)
            search = _find_ci(ASSETS, 'search/search.png', 'search/search.svg')
            if search and (adir / 'search').is_dir():
                apply_search_icon(search)
            settings_logo = _find_ci(adir, 'branding/settings.png', 'branding/settings-logo.png')
            if settings_logo:
                try:
                    install_settings_icon(settings_logo)
                except (OSError, ImportError) as exc:
                    log(f'settings icon: skipped ({exc})')
            log('assets: installed')
        # icon themes
        idir = root / 'icons'
        themes = sorted(p for p in idir.iterdir() if (p / 'index.theme').is_file()) if idir.is_dir() else []
        themes = [p for p in themes if _THEME_RE.match(p.name)]
        for t in themes:
            install_icon_theme(t, t.name, inherit_fenestra=True)
        chosen = None
        if themes:
            wanted = m.get('icon_theme')
            chosen = wanted if wanted in [t.name for t in themes] else themes[0].name
        # glyphs and app logos (icon-overrides.json for Fenestra Shell; icon: glyphs in the theme)
        has_glyphs = (root / 'glyphs').is_dir()
        if has_glyphs and chosen is None:
            chosen = m.get('icon_theme') if isinstance(m.get('icon_theme'), str) and _THEME_RE.match(m['icon_theme']) \
                else 'Fenestra-Windows'
        install_glyphs_and_logos(root, pack_id, chosen)
        if chosen:
            gsettings_set('org.gnome.desktop.interface', 'icon-theme', chosen)
            # KDE Frameworks apps and the KDE file dialogs of the Fenestra (KWin) session read kdeglobals.
            if APPLY and shutil.which('kwriteconfig6'):
                subprocess.run(['kwriteconfig6', '--file', 'kdeglobals', '--group', 'Icons', '--key', 'Theme', chosen], check=False)
            if APPLY and shutil.which('kbuildsycoca6'):
                subprocess.run(['kbuildsycoca6'], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            log(f'icons: theme {chosen}')
        # accent colour
        accent = m.get('accent') or m.get('accent_color')
        if isinstance(accent, str) and re.match(r'^#[0-9a-fA-F]{6}$', accent):
            if APPLY and schema_has_key('org.fenestra.desktop', 'accent-color-custom'):
                gsettings_set('org.fenestra.desktop', 'accent-color-custom', accent)
                log(f'accent: {accent}')
        ASSETS.mkdir(parents=True, exist_ok=True)
        (ASSETS / '.imported-pack').write_text(json.dumps(
            {'id': pack_id, 'name': m.get('name'), 'source': src, 'file': str(path)}) + '\n')
    return info


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--windows', help='path where the Windows partition is mounted')
    ap.add_argument('--dry-run', action='store_true')
    ap.add_argument('--no-cursors', action='store_true')
    ap.add_argument('--pack', metavar='FILE.zip', help='install a Fenestra icon pack or icon theme zip')
    ap.add_argument('--inspect', action='store_true', help='with --pack: validate and print the manifest as JSON')
    ap.add_argument('--no-apply', action='store_true',
                    help='only write files under XDG_DATA_HOME (no gsettings, no cache refresh)')
    args = ap.parse_args()
    global APPLY
    APPLY = not args.no_apply
    if args.pack:
        try:
            if args.inspect:
                info = inspect_pack(args.pack)
                print(json.dumps({'kind': info['kind'], 'manifest': info['manifest'],
                                  'files': len(info['names']), 'bytes': info['total']}, indent=2))
                return 0
            import_pack(args.pack, args.dry_run)
        except PackError as exc:
            log(f'invalid pack: {exc}')
            return 2
        log('done — log out and back in to see everything')
        return 0
    win = find_windows(args.windows)
    if not win:
        log('no Windows partition found (mount it first, read-only is fine)')
        return 1
    log(f'using Windows installation at {win}')
    import_fonts(win, args.dry_run)
    if not args.no_cursors:
        import_cursors(win, args.dry_run)
    import_battery(win, args.dry_run)
    import_folders(win, args.dry_run)
    import_taskbar_icons(win, args.dry_run)
    import_settings_icon(win, args.dry_run)
    if not args.dry_run:
        (ASSETS / '.imported').parent.mkdir(parents=True, exist_ok=True)
        (ASSETS / '.imported').write_text(str(win) + '\n')
    log('done — log out and back in to see everything')
    return 0


if __name__ == '__main__':
    sys.exit(main())
