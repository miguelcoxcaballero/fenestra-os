def fix_file_type_icons(theme_dir):
    """Per-type icons from the extractor: a blank page means "no app on that PC". Text types get the
    text-document icon; other blank ones are dropped so the inherited theme's icon shows."""
    for mdir in Path(theme_dir).glob('*/mimetypes'):
        blank = mdir / 'unknown.png'
        text = mdir / 'text-plain.png'
        if not blank.is_file():
            continue
        ref = blank.read_bytes()
        for f in mdir.glob('*.png'):
            if f.name in ('unknown.png', 'application-octet-stream.png', 'application-x-generic.png') or f.read_bytes() != ref:
                continue
            if f.stem in TEXTISH_ICONS and text.is_file():
                shutil.copyfile(text, f)
            else:
                f.unlink()


def install_icon_theme(src, name, inherit_fenestra=True):
    """Copy an icon theme directory to ~/.local/share/icons/<name>."""
    dest = DATA / 'icons' / name
    if dest.exists():
        shutil.rmtree(dest)
    shutil.copytree(src, dest, symlinks=False)
    fix_file_type_icons(dest)
    index = dest / 'index.theme'
    if inherit_fenestra and index.exists():
        text = index.read_text(errors='replace')
        m = re.search(r'^Inherits\s*=\s*(.*)$', text, re.M)
        inherits = [t.strip() for t in (m.group(1).split(',') if m else []) if t.strip()]
        if 'Fenestra' not in inherits:
            inherits = ['Fenestra'] + inherits
            line = 'Inherits=' + ','.join(inherits)
            text = (text[:m.start()] + line + text[m.end():]) if m else \
                re.sub(r'^(\[Icon Theme\][^\n]*\n)', lambda mm: mm.group(1) + line + '\n', text, count=1, flags=re.M)
            index.write_text(text)
    if APPLY:
        subprocess.run(['gtk-update-icon-cache', '-q', '-f', '-t', str(dest)], check=False)
    return dest


