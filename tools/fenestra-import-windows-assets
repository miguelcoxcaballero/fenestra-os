def _textish(mime):
    return mime.startswith('text/') or mime in ('application/json', 'application/xml', 'application/javascript',
                                                 'application/x-shellscript', 'application/x-desktop', 'application/toml',
                                                 'application/yaml', 'application/x-yaml', 'application/sql', 'application/x-ini')


def load_mime_db():
    """(globs: ext -> [(weight, mime)], icons: mime -> icon, generic: mime -> generic, parents: mime -> [mime],
    types: [mime], aliases: alias -> mime) from shared-mime-info (user dir first)."""
    globs, icons, generic, parents, types, aliases = {}, {}, {}, {}, [], {}
    for d in reversed(MIME_DIRS):
        if not (d / 'types').is_file():
            continue
        for line in (d / 'globs2').read_text(errors='replace').splitlines() if (d / 'globs2').is_file() else []:
            if line.startswith('#'):
                continue
            parts = line.split(':')
            if len(parts) < 3:
                continue
            weight, mime, glob = parts[0], parts[1], parts[2]
            m = re.match(r'^\*\.([A-Za-z0-9+_-]+(?:\.[A-Za-z0-9+_-]+)?)$', glob)
            if m:
                globs.setdefault(m.group(1).lower(), []).append((int(weight) if weight.isdigit() else 50, mime))
        for fname, into in (('icons', icons), ('generic-icons', generic)):
            for line in (d / fname).read_text(errors='replace').splitlines() if (d / fname).is_file() else []:
                if ':' in line:
                    k, v = line.split(':', 1)
                    into[k.strip()] = v.strip()
        for line in (d / 'subclasses').read_text(errors='replace').splitlines() if (d / 'subclasses').is_file() else []:
            p = line.split()
            if len(p) == 2:
                parents.setdefault(p[0], []).append(p[1])
        for line in (d / 'aliases').read_text(errors='replace').splitlines() if (d / 'aliases').is_file() else []:
            p = line.split()
            if len(p) == 2:
                aliases[p[0]] = p[1]
        types += [t.strip() for t in (d / 'types').read_text(errors='replace').splitlines() if '/' in t]
    return globs, icons, generic, parents, sorted(set(types)), aliases


def _index_dirs(theme_dir, dirs):
    """Add fixed-size / scalable directories to an installed theme's index.theme."""
    index = theme_dir / 'index.theme'
    if not index.exists():
        theme_dir.mkdir(parents=True, exist_ok=True)
        index.write_text(f'[Icon Theme]\nName={theme_dir.name}\nComment=Icons from your Fenestra icon pack\n'
                         'Inherits=Fenestra,Win11,Adwaita,hicolor\nDirectories=\n')
    text = index.read_text(errors='replace')
    m = re.search(r'^Directories\s*=\s*(.*)$', text, re.M)
    have = [d.strip() for d in (m.group(1).split(',') if m else []) if d.strip()]
    for d in dirs:
        if d not in have:
            have.append(d)
    line = 'Directories=' + ','.join(have)
    text = (text[:m.start()] + line + text[m.end():]) if m else text.replace('[Icon Theme]\n', '[Icon Theme]\n' + line + '\n', 1)
    contexts = {'mimetypes': 'MimeTypes', 'places': 'Places', 'devices': 'Devices', 'emblems': 'Emblems',
                'status': 'Status', 'actions': 'Actions', 'apps': 'Applications'}
    for d in dirs:
        if f'[{d}]' in text:
            continue
        size, ctx = d.split('/', 1)
        if size == 'scalable':
            text = text.rstrip('\n') + f'\n\n[{d}]\nSize=48\nMinSize=8\nMaxSize=512\nType=Scalable\nContext={contexts.get(ctx, "Status")}\n'
        else:
            n = int(size.split('x')[0])
            text = text.rstrip('\n') + f'\n\n[{d}]\nSize={n}\nContext={contexts.get(ctx, "Status")}\nType=Fixed\n'
    index.write_text(text)


def _place(src, dest):
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.exists() or dest.is_symlink():
        dest.unlink()
    try:
        os.link(src, dest)
    except OSError:
        shutil.copyfile(src, dest)


def install_filetypes(root, dest, theme_dir, overrides):
    """filetypes/ -> pack folder, freedesktop mimetype/place/device icons in the theme (every MIME type
    of the shared-mime-info database whose extension Windows knows, its subclasses, and the rest as
    Windows' unknown-type page), and icon-overrides.json entries for Fenestra Shell. Returns counts."""
    fdir = root / 'filetypes'
    try:
        index = json.loads((fdir / 'filetypes.json').read_text(encoding='utf-8'))
    except (OSError, ValueError, UnicodeDecodeError):
        return {}
    items = index.get('items') if isinstance(index.get('items'), dict) else {}
    have = {}   # key -> {size: Path}
    for key, meta in items.items():
        if not _FT_KEY_RE.match(key) or not isinstance(meta, dict) or not isinstance(meta.get('files'), dict):
            continue
        sizes = {}
        for s, rel in meta['files'].items():
            if not (isinstance(s, str) and s.isdigit() and int(s) in FT_SIZES and rel == f'{s}x{s}/{key}.png'):
                continue
            src = fdir / rel
            if not src.is_file() or src.is_symlink() or src.stat().st_size > LOGO_MAX_FILE:
                continue
            data = src.read_bytes()
            if _png_size(data[:32]) != (int(s), int(s)):
                continue
            out = dest / 'filetypes' / rel
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_bytes(data)
            sizes[int(s)] = out
        if sizes:
            have[key] = sizes
    shutil.copyfile(fdir / 'filetypes.json', dest / 'filetypes' / 'filetypes.json')
    if not have:
        return {}
    globs, mime_icons, generic, parents, types, aliases = load_mime_db()
    # MIME type -> pack key: exported extensions through the globs (highest weight wins), the content
    # type Windows registers for the extension, then the subclass chain, then Windows' unknown page.
    direct = {}
    for key, meta in items.items():
        if key not in have or meta.get('kind') != 'extension':
            continue
        ext = key
        for weight, mime in globs.get(ext, []):
            cur = direct.get(mime)
            if cur is None or weight > cur[0]:
                direct[mime] = (weight, key)
        ct = meta.get('content_type')
        if isinstance(ct, str) and re.match(r'^[a-z0-9.+-]+/[a-z0-9.+-]+$', ct):
            ct = aliases.get(ct, ct)
            if ct in types and ct not in direct:
                direct[ct] = (0, key)
    # Exactly what Explorer shows: a type nothing handles on that PC keeps Windows' blank page.
    choice = {m: k for m, (_, k) in direct.items()}
    text_key = 'txt' if 'txt' in have else None

    def resolve(m, seen=()):
        if m in choice:
            return choice[m]
        for p in parents.get(m, []):
            if p not in seen and p not in ('application/octet-stream',):
                k = resolve(p, seen + (m,))
                if k:
                    return k
        return None
    names = {}   # icon name -> (context, key)
    for m in types:
        if m.startswith(('inode/', 'x-content/', 'multipart/')) and m not in ('inode/directory',):
            continue
        key = 'folder' if m == 'inode/directory' else resolve(m)
        if key is None:
            key = text_key if (text_key and _textish(m)) else ('unknown' if 'unknown' in have else None)
        if key is None:
            continue
        for icon in {mime_icons.get(m) or m.replace('/', '-')}:
            names.setdefault(icon, ('mimetypes', key))
    # aliases (application/x-ms-dos-executable for application/x-msdownload, ...): same icon
    for alias, canon in aliases.items():
        ctx_key = names.get(mime_icons.get(canon) or canon.replace('/', '-'))
        if ctx_key:
            names.setdefault(alias.replace('/', '-'), ctx_key)
    # generic names (asked when a specific one is missing): Windows' icon of a representative type
    for gname, key in (('text-x-generic', 'txt'), ('image-x-generic', 'png'), ('audio-x-generic', 'mp3'),
                       ('video-x-generic', 'mp4'), ('package-x-generic', 'zip'), ('font-x-generic', 'ttf'),
                       ('x-office-document', 'docx'), ('x-office-spreadsheet', 'xlsx'), ('x-office-presentation', 'pptx'),
                       ('x-office-drawing', 'odg'), ('application-x-executable', 'exe'), ('text-x-script', 'bat'),
                       ('text-html', 'html'), ('application-x-generic', 'unknown'), ('unknown', 'unknown'),
                       ('application-octet-stream', 'unknown'), ('text-x-generic-template', 'txt'),
                       ('application-x-addon', 'dll'), ('application-x-firmware', 'bin'),
                       ('x-office-calendar', 'ics'), ('x-office-address-book', 'vcf'), ('text-x-preview', 'txt')):
        if key in have:
            names[gname] = ('mimetypes', key)
    for key, (ctx, icons) in PLACE_NAMES.items():
        key = key.rstrip('#')               # '#': a second row for the same pack key
        if key in have:
            for icon in icons:
                names[icon] = (ctx, key)
    dirs = set()
    for icon, (ctx, key) in names.items():
        files = []
        for s, src in sorted(have[key].items()):
            d = f'{s}x{s}/{ctx}'
            dirs.add(d)
            if theme_dir is not None:
                _place(src, theme_dir / d / f'{icon}.png')
            files.append(str(src))
        overrides['icons'][icon] = files
        overrides['icons_light'][icon] = files
    if theme_dir is not None:
        _index_dirs(theme_dir, sorted(dirs, key=lambda d: (int(d.split('x')[0]), d)))
    # Empty / non-empty folder pictures of the Explorer layer (desktop/lib/folder-icons) and of Fenestra
    # Shell's desktop: Explorer's own 256 px folder and folder-with-content preview.
    # UAC shield of the consent dialog (SIID_SHIELD)
    shield = have.get('shield', {})
    if shield:
        src = shield.get(96) or shield[max(shield)]
        overrides['assets']['consent/shield.svg'] = str(src)
        overrides['assets_light']['consent/shield.svg'] = str(src)
    for key, name in (('folder', 'folder-empty'), ('folder-full', 'folder-full')):
        src = have.get(key, {}).get(256)
        if src is None:
            continue
        out = ASSETS / 'folders' / f'{name}.png'
        out.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, out)
        for rel in (f'folders/{name}.svg', f'folders/{name}.png'):
            overrides['assets'][rel] = str(src)
            overrides['assets_light'][rel] = str(src)
    n_types = sum(1 for _, (c, _k) in names.items() if c == 'mimetypes')
    log(f'file types: {len(have)} Windows icons ({len([k for k in items if items[k].get("kind") == "extension" and k in have])} '
        f'extensions, {len([k for k in items if items[k].get("kind") == "special" and k in have])} places), '
        f'{n_types} MIME icon names, {len(names) - n_types} place/device names')
    return {'keys': len(have), 'names': len(names), 'mime_names': n_types}


