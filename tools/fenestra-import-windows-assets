def import_cursors(win, dry):
    cdir = ci(win / 'Windows' / 'Cursors')
    if not cdir:
        log('cursors: not found')
        return False
    return build_cursor_theme(cdir, 'Fenestra-Windows-Cursors', dry)


def build_cursor_theme(cdir, theme, dry, comment='Cursors imported from your own Windows installation'):
    """Convert Windows .cur/.ani files in ``cdir`` to an Xcursor theme."""
    cdir = Path(cdir)
    out = DATA / 'icons' / theme
    if dry:
        log(f'cursors: would build from {cdir}')
        return True
    cd = out / 'cursors'
    cd.mkdir(parents=True, exist_ok=True)

    def load(name):
        for suffix in ('_xl', '_l', ''):
            p = ci(cdir / f'{name}{suffix}.cur')
            if p:
                return _cur(p.read_bytes())
        return None
    built = 0
    for xname, wname in CURSOR_MAP.items():
        imgs = load(wname)
        if imgs:
            _xcursor(cd / xname, [(im, hx, hy, 0, w) for w, im, hx, hy in imgs])
            built += 1
    busy = ci(cdir / 'aero_busy_xl.ani') or ci(cdir / 'aero_busy.ani')
    work = ci(cdir / 'aero_working_xl.ani') or ci(cdir / 'aero_working.ani')
    for xname, src in (('watch', busy), ('left_ptr_watch', work)):
        if src:
            frames = []
            for frame, delay in _ani(src.read_bytes()):
                for w, im, hx, hy in frame:
                    frames.append((im, hx, hy, delay, w))
            _xcursor(cd / xname, frames)
            built += 1
    for alias, target in ALIASES.items():
        p = cd / alias
        if p.exists() or p.is_symlink():
            p.unlink()
        if (cd / target).exists():
            p.symlink_to(target)
    (out / 'index.theme').write_text(f'[Icon Theme]\nName={theme}\n'
                                     f'Comment={comment}\nInherits=Bibata-Original-Classic\n')
    if built:
        gsettings_set('org.gnome.desktop.interface', 'cursor-theme', theme)
    log(f'cursors: {built} built')
    return True


# ---------------------------------------------------------------- battery ---
def import_battery(win, dry):
    src = None
    for rel in ('Windows/SystemApps/MicrosoftWindows.Client.Core_cw5n1h2txyewy/SystemTray/Assets/Sysbatt.ttf',
                'Windows/SystemResources/Windows.UI.ControlCenter/Assets/Sysbatt.ttf',
                'Windows/SystemApps/Microsoft.LockApp_cw5n1h2txyewy/Assets/Sysbatt.ttf'):
        src = ci(win / rel)
        if src:
            break
    if not src:
        log('battery: Sysbatt.ttf not found')
        return
    build_battery(src, dry)


def build_battery(src, dry):
    """Compose the 99 taskbar battery SVGs from the glyphs of Sysbatt.ttf."""
    if dry:
        log(f'battery: would compose from {src}')
        return
    try:
        from fontTools.pens.boundsPen import BoundsPen
        from fontTools.pens.svgPathPen import SVGPathPen
        from fontTools.pens.transformPen import TransformPen
        from fontTools.ttLib import TTFont
    except ImportError:
        log('battery: python3-fonttools not installed, skipped')
        return
    f = TTFont(str(src))
    gs, cm = f.getGlyphSet(), f.getBestCmap()
    outline = {'plain': 0xf8d0, 'bolt': 0xf8db, 'plug': 0xf8e4}
    fill = {'plain': [None] + list(range(0xf8d1, 0xf8db)),
            'bolt': [None, 0xf8d1, 0xf8d2] + list(range(0xf8dc, 0xf8e4)),
            'plug': [None, 0xf8d1, 0xf8d2] + list(range(0xf8e5, 0xf8ed))}
    b = BoundsPen(gs)
    for cp in outline.values():
        gs[cm[cp]].draw(b)
    x0, y0, x1, y1 = b.bounds
    S = 24 / max(x1 - x0, y1 - y0)
    tx, ty = 12 - (x0 + x1) * S / 2, 12 + (y0 + y1) * S / 2

    def path(cp):
        p = SVGPathPen(gs)
        gs[cm[cp]].draw(TransformPen(p, (S, 0, 0, -S, tx, ty)))
        return p.getCommands()

    def svg(kind, level, color):
        parts = [f'<path fill="#ffffff" d="{path(outline[kind])}"/>']
        if fill[kind][level]:
            parts.append(f'<path fill="{color}" d="{path(fill[kind][level])}"/>')
        return '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">' + ''.join(parts) + '</svg>\n'
    out = ASSETS / 'battery'
    out.mkdir(parents=True, exist_ok=True)
    green, yellow, red, white = '#9fd89f', '#fce100', '#ff99a4', '#ffffff'
    for lvl in range(11):
        for v in (0, 1):
            (out / f'normal-{v}-{lvl}.svg').write_text(svg('plain', lvl, white))
            (out / f'saver-{v}-{lvl}.svg').write_text(svg('plain', lvl, yellow))
            (out / f'low-{v}-{lvl}.svg').write_text(svg('plain', lvl, red))
            (out / f'charging-{v}-{lvl}.svg').write_text(svg('bolt', lvl, green))
        (out / f'plugged-0-{lvl}.svg').write_text(svg('plug', lvl, green))
    log('battery: 99 glyphs')


# ---------------------------------------------------------------- folders ---
def import_folders(win, dry):
    mun = ci(win / 'Windows/SystemResources/imageres.dll.mun')
    if not mun or not shutil.which('wrestool'):
        log('folders: imageres.dll.mun or wrestool (icoutils) missing')
        return
    if dry:
        log(f'folders: would extract from {mun}')
        return
    from PIL import Image
    out = ASSETS / 'folders'
    out.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        for rid, name in ((3, 'folder-empty'), (162, 'folder-full')):
            ico = Path(tmp) / f'{rid}.ico'
            subprocess.run(['wrestool', '-x', '--type=14', f'--name={rid}', '-o', str(ico), str(mun)], check=False,
                           stderr=subprocess.DEVNULL)
            if ico.exists():
                im = Image.open(ico)
                im.size = max(im.info.get('sizes', {(256, 256)}))
                im.convert('RGBA').save(out / f'{name}.png')
    log('folders: empty/full icons')


# ------------------------------------------------------- taskbar icons ---
def import_taskbar_icons(win, dry):
    core = ci(win / 'Windows/SystemApps/MicrosoftWindows.Client.Core_cw5n1h2txyewy')
    logo = ci(core / 'Icons/WindowsLogo.svg') if core else None
    search = None
    shared = ci(win / 'Windows/SystemApps/Shared')
    if shared:
        for scale in ('400', '200', '100'):
            hits = sorted(shared.glob(f'SearchIconOnDark.scale-{scale}/*/SearchIconOnDark.scale-{scale}.png'))
            if hits:
                search = hits[0]
                break
    if dry:
        log(f'taskbar: start logo {logo or "missing"}, search icon {search or "missing"}')
        return
    if logo:
        dest = ASSETS / 'branding' / 'start-button.svg'
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(logo, dest)
        apply_start_logo(dest)
    if search:
        dest = ASSETS / 'search' / 'search.png'
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(search, dest)
        apply_search_icon(dest)
    log(f'taskbar: start logo {"imported" if logo else "not found"}, search icon {"imported" if search else "not found"}')


def shell_conf_set(section, key, value):
    """One key of ~/.config/fenestra/shell.conf (Fenestra Shell, KWin session); other lines kept."""
    path = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'fenestra' / 'shell.conf'
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = path.read_text().splitlines() if path.exists() else []
    out, current, done = [], None, False
    for line in lines:
        st = line.strip()
        if st.startswith('[') and st.endswith(']'):
            if current == section and not done:
                out.append(f'{key}={value}')
                done = True
            current = st[1:-1]
        elif current == section and st.split('=', 1)[0].strip() == key:
            if not done:
                out.append(f'{key}={value}')
                done = True
            continue
        out.append(line)
    if not done:
        if current != section:
            out += ([''] if out and out[-1].strip() else []) + [f'[{section}]']
        out.append(f'{key}={value}')
    tmp = path.with_suffix('.conf.tmp')
    tmp.write_text('\n'.join(out) + '\n')
    os.replace(tmp, path)


def apply_start_logo(path):
    """Use ``path`` as the taskbar Start button: ArcMenu's menu button icon (GNOME session) and
    Fenestra Shell's StartIcon (Fenestra session)."""
    gsettings_set('org.gnome.shell.extensions.arcmenu', 'menu-button-icon', str(path))
    shell_conf_set('Appearance', 'StartIcon', str(path))


def apply_search_icon(path):
    """User copy of fenestra-search.desktop pointing at ``path`` (and Fenestra Shell's SearchIcon)."""
    shell_conf_set('Appearance', 'SearchIcon', str(path))
    src_desktop = Path('/usr/share/applications/fenestra-search.desktop')
    if src_desktop.exists():
        apps = DATA / 'applications'
        apps.mkdir(parents=True, exist_ok=True)
        text = src_desktop.read_text()
        text = '\n'.join(f'Icon={path}' if l.startswith('Icon=') else l for l in text.splitlines()) + '\n'
        (apps / 'fenestra-search.desktop').write_text(text)


def import_settings_icon(win, dry):
    """Settings logo -> user hicolor theme, overriding Fenestra's own gear icon for this user."""
    images = ci(win / 'Windows/ImmersiveControlPanel/images')
    if not images:
        log('settings icon: ImmersiveControlPanel/images not found')
        return
    cands = [p for p in images.glob('logo*.png') if 'contrast' not in p.name.lower()]
    # Prefer the unplated (transparent) large target sizes, then the scaled tiles.
    def rank(p):
        n = p.name.lower()
        size = 0
        try:
            from PIL import Image
            with Image.open(p) as im:
                size = im.size[0]
        except Exception:  # noqa: BLE001 - Pillow missing or unreadable file
            pass
        return ('unplated' in n, 'targetsize' in n, size)
    cands.sort(key=rank, reverse=True)
    if not cands:
        log('settings icon: no logo*.png found')
        return
    src = cands[0]
    if dry:
        log(f'settings icon: would use {src}')
        return
    install_settings_icon(src, images)


def install_settings_icon(src, images=None):
    """Install ``src`` (PNG) as the user's fenestra-settings icon."""
    src = Path(src)
    icons = DATA / 'icons' / 'hicolor'
    try:
        from PIL import Image
    except ImportError:
        Image = None
    written = []
    for size in (256, 48, 32):
        dest = icons / f'{size}x{size}' / 'apps' / 'fenestra-settings.png'
        dest.parent.mkdir(parents=True, exist_ok=True)
        exact = images / f'logo.targetsize-{size}_altform-unplated.png' if images else None
        if exact is not None and exact.exists():
            shutil.copyfile(exact, dest)
        elif Image is not None:
            with Image.open(src) as im:
                im.convert('RGBA').resize((size, size), Image.LANCZOS).save(dest)
        elif size == 256:
            shutil.copyfile(src, dest)
        else:
            continue
        written.append(dest)
    # A scalable entry always wins over fixed sizes in icon lookup, so replace Fenestra's own
    # scalable gear (if installed for this user) with an SVG that embeds the imported PNG.
    import base64
    png = (icons / '256x256' / 'apps' / 'fenestra-settings.png').read_bytes()
    svg = icons / 'scalable' / 'apps' / 'fenestra-settings.svg'
    svg.parent.mkdir(parents=True, exist_ok=True)
    svg.write_text('<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" '
                   'width="256" height="256" viewBox="0 0 256 256"><!-- fenestra-imported-icon -->'
                   '<image width="256" height="256" xlink:href="data:image/png;base64,'
                   + base64.b64encode(png).decode() + '"/></svg>\n')
    index = icons / 'index.theme'
    if not index.exists() and Path('/usr/share/icons/hicolor/index.theme').exists():
        shutil.copyfile('/usr/share/icons/hicolor/index.theme', index)
    if APPLY:
        subprocess.run(['gtk-update-icon-cache', '-q', '-f', '-t', str(icons)], check=False)
    log(f'settings icon: imported {src.name} ({len(written)} sizes + scalable)')


# ------------------------------------------------------------ icon packs ---
# docs/ICON-PACK-FORMAT.md (v1). Keep in sync with fenestra_oobe/iconpack.py.
PACK_FORMAT = 'fenestra-icon-pack'
PACK_VERSION = 1
MAX_PACK_BYTES = 1 << 30          # 1 GB uncompressed
MAX_PACK_FILES = 100_000
_ID_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$')
_THEME_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9 ._+-]{0,63}$')


class PackError(Exception):
    pass


def _safe_member(name):
    """Normalise a zip member name; refuse absolute paths and '..'."""
    if not name or '\x00' in name:
        raise PackError('empty or invalid file name in pack')
    n = name.replace('\\', '/')
    if n.startswith('/') or re.match(r'^[A-Za-z]:', n):
        raise PackError(f'absolute path in pack: {name}')
    parts = [p for p in n.split('/') if p not in ('', '.')]
    if '..' in parts:
        raise PackError(f'path traversal in pack: {name}')
    return '/'.join(parts)


def _read_index_name(zf, member, fallback):
    try:
        text = zf.read(member).decode('utf-8', 'replace')
    except (KeyError, zipfile.BadZipFile):
        return fallback
    m = re.search(r'^Name\s*=\s*(.+)$', text, re.M)
    name = (m.group(1).strip() if m else '') or fallback
    name = re.sub(r'[^A-Za-z0-9 ._+-]', '-', name).strip(' .-')[:64]
    return name if _THEME_RE.match(name or '') else fallback


def inspect_pack(path, max_bytes=MAX_PACK_BYTES):
    """Validate a pack zip without extracting it.

    Returns {'kind': 'fenestra'|'theme', 'manifest': dict, 'prefix': str,
    'names': [...], 'total': int, ...}; raises PackError with a readable reason.
    """
    try:
        zf = zipfile.ZipFile(path)
    except (zipfile.BadZipFile, OSError) as exc:
        raise PackError(f'not a valid zip file ({exc})') from None
    with zf:
        infos = zf.infolist()
        if len(infos) > MAX_PACK_FILES:
            raise PackError('pack contains too many files')
        names, total = [], 0
        for info in infos:
            n = _safe_member(info.filename)
            if stat.S_ISLNK(info.external_attr >> 16):
                raise PackError(f'symbolic link in pack: {info.filename}')
            total += info.file_size
            if total > max_bytes:
                raise PackError('pack is too large (over 1 GB uncompressed)')
            if n and not info.is_dir():
                names.append(n)
        manifests = sorted((n for n in names if n.rsplit('/', 1)[-1] == 'fenestra-pack.json'
                            and n.count('/') <= 1), key=lambda n: n.count('/'))
        if manifests:
            member = manifests[0]
            prefix = member[:-len('fenestra-pack.json')]
            try:
                data = json.loads(zf.read(member).decode('utf-8'))
            except (ValueError, UnicodeDecodeError):
                raise PackError('fenestra-pack.json is not valid JSON') from None
            if not isinstance(data, dict):
                raise PackError('fenestra-pack.json must contain a JSON object')
            if data.get('format') != PACK_FORMAT:
                raise PackError(f'not a Fenestra icon pack (format is {data.get("format")!r})')
            version = data.get('version')
            if not isinstance(version, int) or isinstance(version, bool) or version != PACK_VERSION:
                raise PackError(f'unsupported pack version {version!r} (supported: {PACK_VERSION})')
            if not isinstance(data.get('id'), str) or not _ID_RE.match(data['id']):
                raise PackError('fenestra-pack.json has a missing or invalid "id"')
            for key in ('icon_theme', 'cursor_theme'):
                if key in data and (not isinstance(data[key], str) or not _THEME_RE.match(data[key])):
                    raise PackError(f'fenestra-pack.json has an invalid "{key}"')
            if not isinstance(data.get('name'), str) or not data['name'].strip():
                data['name'] = data['id']
            return {'kind': 'fenestra', 'manifest': data, 'prefix': prefix, 'names': names, 'total': total}
        themes = sorted((n for n in names if n.rsplit('/', 1)[-1] == 'index.theme'),
                        key=lambda n: n.count('/'))
        if themes:
            member = themes[0]
            theme_dir = member[:-len('index.theme')]
            fallback = (theme_dir.rstrip('/').rsplit('/', 1)[-1] or Path(path).stem)
            fallback = re.sub(r'[^A-Za-z0-9 ._+-]', '-', fallback).strip(' .-')[:64] or 'Imported-Icons'
            name = _read_index_name(zf, member, fallback)
            return {'kind': 'theme', 'manifest': {'name': name, 'id': name}, 'prefix': theme_dir,
                    'theme_name': name, 'names': names, 'total': total}
        raise PackError('missing fenestra-pack.json (and no index.theme): this is not an icon pack')


def safe_extract(path, dest, max_bytes=MAX_PACK_BYTES):
    """Extract a validated pack into ``dest`` counting real decompressed bytes."""
    dest = Path(dest).resolve()
    written = 0
    with zipfile.ZipFile(path) as zf:
        for info in zf.infolist():
            n = _safe_member(info.filename)
            if not n or stat.S_ISLNK(info.external_attr >> 16):
                continue
            target = (dest / n).resolve()
            if dest not in target.parents and target != dest:
                raise PackError(f'path traversal in pack: {info.filename}')
            if info.is_dir():
                target.mkdir(parents=True, exist_ok=True)
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            with zf.open(info) as src, open(target, 'wb') as out:
                while chunk := src.read(1 << 16):
                    written += len(chunk)
                    if written > max_bytes:
                        raise PackError('pack is too large (over 1 GB uncompressed)')
                    out.write(chunk)
    return written


def _find_ci(base, *names):
    for name in names:
        hit = ci(Path(base) / name)
        if hit and hit.exists():
            return hit
    return None


