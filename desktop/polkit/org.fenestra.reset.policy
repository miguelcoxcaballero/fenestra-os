<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Fenestra</vendor>
  <vendor_url>https://github.com/miguelcoxcaballero/fenestra-os</vendor_url>
  <action id="org.fenestra.reset">
    <description>Reset this PC</description>
    <description xml:lang="es">Restablecer este equipo</description>
    <message>Authentication is required to reset this PC</message>
    <message xml:lang="es">Se necesita autenticación para restablecer este equipo</message>
    <icon_name>system-reboot</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/fenestra/fenestra-reset</annotate>
  </action>
</policyconfig>
