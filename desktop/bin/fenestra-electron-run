#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# fenestra-electron-run PROGRAM [ARGS...]: runs an Electron app that draws its own title bar
# without the GNOME circles behind its caption buttons (lib/electron-captions explains how).
# Fenestra installs a launcher of this kind for each such app (tools/install-electron-captions.sh).
for lib in "$HOME/.local/lib/fenestra/fenestra-electron-captions.so" /usr/lib64/fenestra/fenestra-electron-captions.so; do
    if [ -r "$lib" ]; then
        LD_PRELOAD="$lib${LD_PRELOAD:+ $LD_PRELOAD}"; export LD_PRELOAD
        break
    fi
done
exec "$@"
