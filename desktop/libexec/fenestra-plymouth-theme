#!/usr/bin/python3
"""Build Fenestra's Plymouth theme (Windows-11-style boot, restart and update screens).

    fenestra-plymouth-theme OUT_DIR [--lang es] [--bgrt] [--dracut]

--dracut (root) also installs a dracut module so the initramfs uses Fenestra's font.

- Boot: the firmware's own logo (ACPI BGRT, like Windows) with the dot spinner below.
- Restart / shut down: black, spinner, "Restarting" / "Shutting down".
- Updates and release upgrades: black, spinner, "Working on updates", "NN% complete",
  "Don't turn off your computer", with the real progress Plymouth gets from the
  offline update (dnf system-upgrade / PackageKit offline updates).
The spinner frames are drawn here (white dots on a circle, Windows' easing); no
Microsoft artwork is used. Needs python3-pillow.
"""
import math
import os
import sys

from PIL import Image, ImageDraw

STRINGS = {
    'en': {'updates': 'Working on updates', 'complete': '{}% complete', 'keep': "Don't turn off your computer",
           'upgrade': 'Working on updates', 'restart': 'Restarting', 'shutdown': 'Shutting down',
           'firmware': 'Working on updates'},
    'es': {'updates': 'Trabajando en las actualizaciones', 'complete': '{} % completado',
           'keep': 'No apagues el equipo', 'upgrade': 'Trabajando en las actualizaciones',
           'restart': 'Reiniciando', 'shutdown': 'Apagando', 'firmware': 'Trabajando en las actualizaciones'},
}
FRAMES = 90           # 3 s at 30 fps
DOTS = 5


def ease(t):
    """Windows-like: dots rush through the top and slow down at the bottom."""
    return t - math.sin(2 * math.pi * t) / (2 * math.pi) * 0.9


def frame(i, size, dot):
    img = Image.new('RGBA', (size * 4, size * 4), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    c = size * 2
    r = (size / 2 - dot) * 4
    cycle = i / FRAMES                     # one cycle = two turns, then a short gap
    for k in range(DOTS):
        t = cycle * 1.12 - k * 0.035       # stagger
        if t < 0 or t > 1:
            continue
        a = ease(t) * 2 * 2 * math.pi + math.pi / 2  # two revolutions, start at the bottom
        alpha = 255
        if t < 0.04:
            alpha = int(255 * t / 0.04)
        if t > 0.94:
            alpha = int(255 * max(0.0, (1 - t) / 0.06))
        x, y = c + r * math.cos(a), c + r * math.sin(a)
        rr = dot * 2
        d.ellipse((x - rr, y - rr, x + rr, y + rr), fill=(255, 255, 255, alpha))
    return img.resize((size, size), Image.LANCZOS)


SCRIPT = r'''# Fenestra boot, restart and update screens (generated by fenestra-plymouth-theme)
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
W = Window.GetWidth(); H = Window.GetHeight();
hidpi = 0; if (W > 2000) hidpi = 1;
mode = Plymouth.GetMode();
updating = 0;
if (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade") updating = 1;

for (i = 0; i < @FRAMES@; i++) {
    if (hidpi) frames[i] = Image("spin2x-" + i + ".png"); else frames[i] = Image("spin-" + i + ".png");
}
spinner = Sprite(frames[0]);
spinner.SetZ(10);

# The font is Selawik (OFL, shipped by Fenestra): dracut puts the theme's Font= into the initramfs.
font = "Selawik Semilight 15"; small = "Selawik 15";
if (hidpi) { font = "Selawik Semilight 30"; small = "Selawik 30"; }

logo = Image("oem.png");
logo_sprite = Sprite();
if (!updating && mode != "shutdown" && mode != "reboot" && logo) {
    lw = logo.GetWidth(); lh = logo.GetHeight();
    logo_sprite.SetImage(logo);
    logo_sprite.SetX(W / 2 - lw / 2);
    logo_sprite.SetY(H * 0.382 - lh / 2);
    spinner.SetX(W / 2 - frames[0].GetWidth() / 2);
    spinner.SetY(H * 0.75 - frames[0].GetHeight() / 2);
} else {
    spinner.SetX(W / 2 - frames[0].GetWidth() / 2);
    spinner.SetY(H * 0.42 - frames[0].GetHeight() / 2);
}

line1 = Sprite(); line2 = Sprite(); line3 = Sprite();
fun center(sprite, img, y) { sprite.SetImage(img); sprite.SetX(W / 2 - img.GetWidth() / 2); sprite.SetY(y); }
gap = frames[0].GetHeight() * 0.9;
base = spinner.GetY() + frames[0].GetHeight() + gap;
step = 34; if (hidpi) step = 68;
progress = 0;

fun draw_text() {
    if (updating) {
        center(line1, Image.Text("@UPDATES@", 1, 1, 1, 1, font), base);
        center(line2, Image.Text("@COMPLETE_A@" + global.progress + "@COMPLETE_B@", 1, 1, 1, 1, font), base + step);
        center(line3, Image.Text("@KEEP@", 1, 1, 1, 1, font), base + step * 2);
    } else if (mode == "reboot") {
        center(line1, Image.Text("@RESTART@", 1, 1, 1, 1, font), base);
    } else if (mode == "shutdown") {
        center(line1, Image.Text("@SHUTDOWN@", 1, 1, 1, 1, font), base);
    }
}
draw_text();

fun system_update(p) {
    v = Math.Int(p);
    if (v < 0) v = 0; if (v > 100) v = 100;
    if (v != global.progress) { global.progress = v; draw_text(); }
}
Plymouth.SetSystemUpdateFunction(system_update);

tick = 0;
fun refresh() {
    global.tick = global.tick + 1;
    spinner.SetImage(frames[Math.Int(global.tick / 2) % @FRAMES@]);
}
Plymouth.SetRefreshFunction(refresh);

# Disk-encryption / emergency prompts stay usable (plain, centred).
prompt = Sprite(); answer = Sprite();
fun display_password(text, bullets) {
    center(prompt, Image.Text(text, 1, 1, 1, 1, small), H * 0.6);
    s = ""; for (i = 0; i < bullets; i++) s = s + "●";
    center(answer, Image.Text(s, 1, 1, 1, 1, small), H * 0.6 + step);
}
fun display_normal() { prompt.SetOpacity(0); answer.SetOpacity(0); }
fun display_question(text, entry) {
    center(prompt, Image.Text(text, 1, 1, 1, 1, small), H * 0.6);
    center(answer, Image.Text(entry, 1, 1, 1, 1, small), H * 0.6 + step);
}
fun display_message(text) { }
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayMessageFunction(display_message);
'''


def bgrt_png(out):
    """Copy the firmware boot logo (what Windows shows) to oem.png."""
    try:
        img = Image.open('/sys/firmware/acpi/bgrt/image').convert('RGBA')
    except OSError:
        return False
    img.save(out)
    return True


def main():
    out = sys.argv[1]
    lang = 'es' if '--lang' in sys.argv and sys.argv[sys.argv.index('--lang') + 1].startswith('es') else 'en'
    os.makedirs(out, exist_ok=True)
    for i in range(FRAMES):
        frame(i, 48, 3.2).save(f'{out}/spin-{i}.png')
        frame(i, 96, 6.4).save(f'{out}/spin2x-{i}.png')
    s = STRINGS[lang]
    a, _, b = s['complete'].partition('{}')
    script = (SCRIPT.replace('@FRAMES@', str(FRAMES)).replace('@UPDATES@', s['updates'])
              .replace('@COMPLETE_A@', a).replace('@COMPLETE_B@', b).replace('@KEEP@', s['keep'])
              .replace('@RESTART@', s['restart']).replace('@SHUTDOWN@', s['shutdown']))
    open(f'{out}/fenestra.script', 'w').write(script)
    open(f'{out}/fenestra.plymouth', 'w').write(
        '[Plymouth Theme]\nName=Fenestra\nDescription=Fenestra boot, restart and update screens\n'
        f'ModuleName=script\n\n[script]\nImageDir={out_final(out)}\nScriptFile={out_final(out)}/fenestra.script\n'
        'Font=Selawik Semilight\n')
    if '--bgrt' in sys.argv and not bgrt_png(f'{out}/oem.png'):
        Image.new('RGBA', (1, 1), (0, 0, 0, 0)).save(f'{out}/oem.png')
    elif not os.path.exists(f'{out}/oem.png'):
        Image.new('RGBA', (1, 1), (0, 0, 0, 0)).save(f'{out}/oem.png')
    if '--dracut' in sys.argv:
        install_dracut_module()
    print(out)


DRACUT_MODULE = r'''#!/bin/bash
# Fenestra: Plymouth draws all text with /usr/share/fonts/Plymouth.ttf (label-freetype),
# which plymouth-populate-initrd links to the system default font. Use Selawik (OFL,
# shipped by Fenestra) for the Fenestra theme. Runs after 45plymouth.
check() { return 0; }
depends() { echo plymouth; }
install() {
    grep -qs "^Theme=fenestra" /etc/plymouth/plymouthd.conf || return 0
    local f
    f=$(fc-match -f "%{file}" "Selawik Semilight" 2>/dev/null)
    case "$f" in *[Ss]elaw*) ;; *) return 0 ;; esac
    inst "$f"
    mkdir -p "$initdir/usr/share/fonts"
    ln -sfn "$f" "$initdir/usr/share/fonts/Plymouth.ttf"
}
'''


def install_dracut_module():
    """Initramfs text font for the theme (see DRACUT_MODULE)."""
    d = '/usr/lib/dracut/modules.d/99fenestra-plymouth'
    os.makedirs(d, exist_ok=True)
    path = f'{d}/module-setup.sh'
    with open(path, 'w') as f:
        f.write(DRACUT_MODULE)
    os.chmod(path, 0o755)


def out_final(out):
    # Paths inside the theme file must be the installed location.
    return os.environ.get('FENESTRA_PLYMOUTH_DIR', '/usr/share/plymouth/themes/fenestra')


if __name__ == '__main__':
    main()
