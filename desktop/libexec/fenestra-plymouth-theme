#!/usr/bin/python3
"""Build Fenestra's Plymouth theme: Windows-11-style boot, restart, shutdown and update screens.

    fenestra-plymouth-theme OUT_DIR [--lang es] [--bgrt] [--dracut]

--dracut (root) also installs the 99fenestra-plymouth dracut module: Plymouth draws all
text with /usr/share/fonts/Plymouth.ttf, which dracut links to the system default font,
so Font= alone never changes the font; the module links the theme's font instead.

Measured on a real Windows 11 25H2 (1920x1080 VM), everything scales with the screen height:
- Boot: the firmware logo (ACPI BGRT) at its native size and position, and the Fluent
  progress ring (a 42 px arc, ~4 px stroke, round caps) centred at 78.4 % of the height.
- Restart / shut down / updates: black, six 6.5 px dots on a 29.5 px-radius circle centred
  at 48.5 %, text in Segoe UI ~20 px starting 60 px below the circle centre:
  "Restarting", "Shutting down", or "Working on updates / NN% complete / Don't turn off
  your computer" with the real progress of the offline update.
No Microsoft artwork is used: the ring and dots are drawn here. Needs python3-pillow.
The font is the system "Segoe UI Variable" when installed (declared as Font= so dracut
copies it into the initramfs), otherwise Plymouth's default font.
"""
import math
import os
import sys

from PIL import Image, ImageDraw

STRINGS = {
    'en': {'updates': 'Working on updates', 'complete': '{}% complete', 'keep': "Don't turn off your computer",
           'restart': 'Restarting', 'shutdown': 'Shutting down'},
    'es': {'updates': 'Trabajando en las actualizaciones', 'complete': '{} % completado',
           'keep': 'No apagues el equipo', 'restart': 'Reiniciando', 'shutdown': 'Apagando'},
}
SS = 4                 # supersampling
REF = 2                # frames are drawn at 2x the 1080p reference size
DOT_FRAMES = 96        # 3.2 s per dot cycle at 30 fps
RING_FRAMES = 60       # 2 s per ring cycle


def dots_frame(i):
    size = int(2 * (29.5 + 6.5) * REF) + 4
    img = Image.new('RGBA', (size * SS, size * SS), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    c = size * SS / 2
    r = 29.5 * REF * SS
    dot = 6.5 * REF * SS / 2
    t0 = i / DOT_FRAMES
    for k in range(6):
        t = t0 * 1.14 - k * 0.026                     # stagger; the tail of the cycle is the empty pause
        if not 0 <= t <= 1:
            continue
        e = t - math.sin(2 * math.pi * t) / (2 * math.pi) * 0.92   # fast at the top, slow at the bottom
        a = math.pi / 2 + e * 4 * math.pi                            # two turns, starting at the bottom
        x, y = c + r * math.cos(a), c + r * math.sin(a)
        d.ellipse((x - dot, y - dot, x + dot, y + dot), fill=(255, 255, 255, 255))
    return img.resize((size, size), Image.LANCZOS)


def ease(t):
    return 4 * t ** 3 if t < 0.5 else 1 - (-2 * t + 2) ** 3 / 2


def ring_frame(i):
    size = int(46 * REF) + 4
    img = Image.new('RGBA', (size * SS, size * SS), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    c = size * SS / 2
    stroke = 4.0 * REF * SS
    r = (42 * REF * SS - stroke) / 2
    t = i / RING_FRAMES
    base = 300 * t                                  # whole ring keeps rotating
    head = base + 285 * ease(min(1.0, t * 2))       # first half: the head runs away
    tail = base + 285 * ease(max(0.0, t * 2 - 1))   # second half: the tail catches up
    if head - tail < 4:
        head = tail + 4
    steps = max(2, int((head - tail) / 1.5))
    for s in range(steps + 1):
        a = math.radians(tail + (head - tail) * s / steps - 90)
        x, y = c + r * math.cos(a), c + r * math.sin(a)
        d.ellipse((x - stroke / 2, y - stroke / 2, x + stroke / 2, y + stroke / 2), fill=(255, 255, 255, 255))
    return img.resize((size, size), Image.LANCZOS)


SCRIPT = r'''# Fenestra: Windows-11-style boot, restart and update screens (generated by fenestra-plymouth-theme)
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
W = Window.GetWidth(); H = Window.GetHeight();
k = H / 1080;                                   # everything is measured on a 1080p screen
mode = Plymouth.GetMode();
updating = 0;
if (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade") updating = 1;
textmode = 0;
if (updating || mode == "shutdown" || mode == "reboot") textmode = 1;

# Frames are drawn at 2x the 1080p size: scale them to this screen.
if (textmode) {
    for (i = 0; i < @DOT_FRAMES@; i++) {
        f = Image("dots-" + i + ".png");
        frames[i] = f.Scale(Math.Int(f.GetWidth() * k / 2), Math.Int(f.GetHeight() * k / 2));
    }
    nframes = @DOT_FRAMES@;
    cy = H * 0.485;
} else {
    for (i = 0; i < @RING_FRAMES@; i++) {
        f = Image("ring-" + i + ".png");
        frames[i] = f.Scale(Math.Int(f.GetWidth() * k / 2), Math.Int(f.GetHeight() * k / 2));
    }
    nframes = @RING_FRAMES@;
    cy = H * 0.784;
}
spinner = Sprite(frames[0]);
spinner.SetX(Math.Int(W / 2 - frames[0].GetWidth() / 2));
spinner.SetY(Math.Int(cy - frames[0].GetHeight() / 2));
spinner.SetZ(10);

# Firmware logo at its native size: the BGRT image is made for the panel's native width.
if (!textmode) {
    logo = Image("oem.png");
    if (logo && logo.GetWidth() > 1) {
        s = @NATIVE_W@ / W;
        if (s < 1) s = 1;
        lw = logo.GetWidth() / s; lh = logo.GetHeight() / s;
        if (lw > W * 0.4) { lh = lh * W * 0.4 / lw; lw = W * 0.4; }
        logo = logo.Scale(Math.Int(lw), Math.Int(lh));
        logo_sprite = Sprite(logo);
        logo_sprite.SetX(Math.Int(W / 2 - lw / 2));
        logo_sprite.SetY(Math.Int(H * @LOGO_CY@ - lh / 2));
    }
}

font = "@FONT@ " + Math.Int(15 * k + 0.5);
line1 = Sprite(); line2 = Sprite(); line3 = Sprite();
fun center(sprite, img, y) { sprite.SetImage(img); sprite.SetX(Math.Int(W / 2 - img.GetWidth() / 2)); sprite.SetY(Math.Int(y)); }
top = cy + 46 * k;
step = 30 * k;
global.progress = 0;

fun draw_text() {
    if (updating) {
        center(line1, Image.Text("@UPDATES@", 1, 1, 1, 1, font), top);
        center(line2, Image.Text("@COMPLETE_A@" + global.progress + "@COMPLETE_B@", 1, 1, 1, 1, font), top + step);
        center(line3, Image.Text("@KEEP@", 1, 1, 1, 1, font), top + step * 2);
    } else if (mode == "reboot") {
        center(line1, Image.Text("@RESTART@", 1, 1, 1, 1, font), top);
    } else if (mode == "shutdown") {
        center(line1, Image.Text("@SHUTDOWN@", 1, 1, 1, 1, font), top);
    }
}
draw_text();

fun system_update(p) {
    v = Math.Int(p);
    if (v < 0) v = 0;
    if (v > 100) v = 100;
    if (v != global.progress) { global.progress = v; draw_text(); }
}
Plymouth.SetSystemUpdateFunction(system_update);

global.tick = 0;
fun refresh() {
    global.tick = global.tick + 1;
    spinner.SetImage(frames[Math.Int(global.tick / 2) % nframes]);
}
Plymouth.SetRefreshFunction(refresh);

# Disk-encryption / emergency prompts stay usable.
prompt = Sprite(); answer = Sprite();
fun display_password(text, bullets) {
    center(prompt, Image.Text(text, 1, 1, 1, 1, font), H * 0.6);
    s = ""; for (i = 0; i < bullets; i++) s = s + "*";
    center(answer, Image.Text(s, 1, 1, 1, 1, font), H * 0.6 + step);
}
fun display_normal() { prompt.SetOpacity(0); answer.SetOpacity(0); }
fun display_question(text, entry) {
    center(prompt, Image.Text(text, 1, 1, 1, 1, font), H * 0.6);
    center(answer, Image.Text(entry, 1, 1, 1, 1, font), H * 0.6 + step);
}
fun display_message(text) { }
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayMessageFunction(display_message);
'''


def read_int(path, default):
    try:
        return int(open(path).read().strip())
    except (OSError, ValueError):
        return default


def main():
    out = sys.argv[1]
    lang = 'en'
    if '--lang' in sys.argv:
        lang = 'es' if sys.argv[sys.argv.index('--lang') + 1].startswith('es') else 'en'
    os.makedirs(out, exist_ok=True)
    for f in os.listdir(out):
        if f.endswith('.png'):
            os.remove(os.path.join(out, f))
    for i in range(DOT_FRAMES):
        dots_frame(i).save(f'{out}/dots-{i}.png')
    for i in range(RING_FRAMES):
        ring_frame(i).save(f'{out}/ring-{i}.png')

    native_w, logo_cy = 1920, 0.5
    logo = Image.new('RGBA', (1, 1), (0, 0, 0, 0))
    if '--bgrt' in sys.argv:
        try:
            logo = Image.open('/sys/firmware/acpi/bgrt/image').convert('RGBA')
            x, y = read_int('/sys/firmware/acpi/bgrt/xoffset', 0), read_int('/sys/firmware/acpi/bgrt/yoffset', 0)
            native_w = 2 * x + logo.width                 # BGRT is centred horizontally for the native mode
            native_h = round(native_w * 10 / 16)
            for mode in _modes():
                if mode[0] == native_w:
                    native_h = mode[1]
                    break
            logo_cy = (y + logo.height / 2) / native_h
        except OSError:
            pass
    logo.save(f'{out}/oem.png')

    font = 'Segoe UI Variable Text'
    if os.system(f'fc-list | grep -q "Segoe UI Variable"') != 0:
        # Fenestra's own UI font (Selawik, OFL), metric-compatible with the reference.
        font = 'Selawik Semilight' if os.system('fc-list | grep -q "Selawik Semilight"') == 0 else 'Sans'
    s = STRINGS[lang]
    a, _, b = s['complete'].partition('{}')
    script = (SCRIPT.replace('@DOT_FRAMES@', str(DOT_FRAMES)).replace('@RING_FRAMES@', str(RING_FRAMES))
              .replace('@NATIVE_W@', str(native_w)).replace('@LOGO_CY@', f'{logo_cy:.4f}')
              .replace('@FONT@', font).replace('@UPDATES@', s['updates']).replace('@COMPLETE_A@', a)
              .replace('@COMPLETE_B@', b).replace('@KEEP@', s['keep']).replace('@RESTART@', s['restart'])
              .replace('@SHUTDOWN@', s['shutdown']))
    open(f'{out}/fenestra.script', 'w').write(script)
    final = os.environ.get('FENESTRA_PLYMOUTH_DIR', '/usr/share/plymouth/themes/fenestra')
    open(f'{out}/fenestra.plymouth', 'w').write(
        '[Plymouth Theme]\nName=Fenestra\nDescription=Fenestra boot, restart and update screens\n'
        'ModuleName=script\n\n[script]\n'
        f'ImageDir={final}\nScriptFile={final}/fenestra.script\n'
        f'Font={font} 15\nTitleFont={font} 15\n')
    if '--dracut' in sys.argv:
        install_dracut_module()
    print(out)


DRACUT_MODULE = r'''#!/bin/bash
# Fenestra: Plymouth's label-freetype draws all text with /usr/share/fonts/Plymouth.ttf,
# which plymouth-populate-initrd links to the system default font. Link the Fenestra
# theme's Font= instead (written by fenestra-plymouth-theme --dracut). Runs after 45plymouth.
check() { return 0; }
depends() { echo plymouth; }
install() {
    local theme=/usr/share/plymouth/themes/fenestra/fenestra.plymouth name f
    grep -qs "^Theme=fenestra" /etc/plymouth/plymouthd.conf || return 0
    name=$(sed -n 's/^Font=\(.*\) [0-9]\+$/\1/p' "$theme" | head -1)
    [ -n "$name" ] || return 0
    f=$(fc-match -f "%{file}" "$name" 2>/dev/null)
    # fc-match always answers; only use it when it found that family.
    fc-query -f "%{family}\n" "$f" 2>/dev/null | tr ',' '\n' | grep -qixF "$name" || return 0
    inst "$f"
    mkdir -p "$initdir/usr/share/fonts"
    ln -sfn "$f" "$initdir/usr/share/fonts/Plymouth.ttf"
}
'''


def install_dracut_module():
    d = '/usr/lib/dracut/modules.d/99fenestra-plymouth'
    os.makedirs(d, exist_ok=True)
    with open(f'{d}/module-setup.sh', 'w') as f:
        f.write(DRACUT_MODULE)
    os.chmod(f'{d}/module-setup.sh', 0o755)


def _modes():
    import glob
    res = []
    for p in glob.glob('/sys/class/drm/card*-eDP-*/modes') + glob.glob('/sys/class/drm/card*-*/modes'):
        try:
            for line in open(p):
                w, _, h = line.strip().partition('x')
                res.append((int(w), int(h.rstrip('i'))))
        except (OSError, ValueError):
            pass
    return res


if __name__ == '__main__':
    main()
