[Desktop Entry]
Type=Application
Name=Fenestra Shell
Comment=Taskbar, Start, quick settings and desktop of the Fenestra session
Exec=/usr/bin/fenestra-shell
NoDisplay=true
OnlyShowIn=Fenestra;
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management,zkde_screencast_unstable_v1,org_kde_kwin_fake_input
# Screenshots (Print) through KWin
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
