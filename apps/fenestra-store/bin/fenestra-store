#!/usr/bin/env python3
"""Launcher for Fenestra Store (works from the source tree and when installed)."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for c in (os.path.dirname(here),                                         # source tree: apps/fenestra-store
          os.path.join(os.path.dirname(here), "share", "fenestra-store"),  # $PREFIX/bin -> $PREFIX/share
          "/usr/share/fenestra-store"):
    if os.path.isdir(os.path.join(c, "fenestra_store")):
        sys.path.insert(0, c)
        break

from fenestra_store.app import main  # noqa: E402

sys.exit(main(sys.argv))
